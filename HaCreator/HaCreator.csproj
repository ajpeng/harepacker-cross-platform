<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8981;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <FileVersion>7.1.1</FileVersion>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Exclude WinForms/WPF/SharpDX UI files — pending Avalonia port -->
  <ItemGroup>
    <!-- GUI forms: all WinForms + WPF windows/dialogs -->
    <Compile Remove="GUI\**" />
    <!-- Re-include pure data classes with no WinForms/WPF deps -->
    <Compile Include="GUI\InstanceEditor\BackgroundStateBackup.cs" />

    <!-- WinForms custom controls -->
    <Compile Remove="CustomControls\**" />

    <!-- WPF IValueConverter classes -->
    <Compile Remove="Converter\**" />

    <!-- WPF/DirectX MonoGame surface embedding -->
    <Compile Remove="MapEditor\MultiBoard.xaml.cs" />
    <Compile Remove="MapEditor\GraphicsDeviceService.cs" />

    <!-- MapEditor files with WinForms/WPF/dockpanelsuite dependencies -->
    <Compile Remove="MapEditor\AI\MarkdownToFlowDocumentConverter.cs" />
    <Compile Remove="MapEditor\BackupManager.cs" />
    <Compile Remove="MapEditor\BoardItemContextMenu.cs" />
    <Compile Remove="MapEditor\HaCreatorStateManager.cs" />
    <Compile Remove="MapEditor\Input\InputHandler.cs" />

    <!-- Auto-generated WinForms resource file — replaced by cross-platform Properties\Resources.cs -->
    <Compile Remove="Properties\Resources.Designer.cs" />

    <!-- WPF/WinForms-heavy Wz loader — pending Avalonia port -->
    <Compile Remove="Wz\MapLoader.cs" />

    <!-- MapSimulator: pending full SkiaSharp + NAudio.Core + Avalonia port -->
    <Compile Remove="MapSimulator\**\*.cs" />

  </ItemGroup>

  <!-- Exclude WPF XAML markup files -->
  <ItemGroup>
    <Page Remove="**\*.xaml" />
    <None Remove="**\*.xaml" />
    <EmbeddedResource Remove="**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HaSharedLibrary\HaSharedLibrary.csproj" />
    <ProjectReference Include="..\MapleLib\MapleLib\MapleLib.csproj" />
    <ProjectReference Include="..\MapleLib\spine-runtimes-2.1.25\spine-csharp\spine-csharp 2.1.25.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform UI -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />

    <!-- Cross-platform MonoGame (replaces MonoGame.Framework.WindowsDX) -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />

    <!-- Cross-platform imaging -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />

    <!-- Audio -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Midi" Version="2.2.1" />

    <!-- SQLite data source -->
    <PackageReference Include="System.Data.SQLite" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI Prompt files -->
    <Content Include="MapEditor\AI\Prompts\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>AI\Prompts\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>
</Project>
