<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8981;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <FileVersion>7.1.1</FileVersion>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Exclude WinForms/WPF/SharpDX UI files — pending Avalonia port -->
  <ItemGroup>
    <!-- GUI forms: all WinForms + WPF windows/dialogs -->
    <Compile Remove="GUI\**" />
    <!-- Re-include pure data classes with no WinForms/WPF deps -->
    <Compile Include="GUI\InstanceEditor\BackgroundStateBackup.cs" />
    <!-- Re-include Avalonia UI files -->
    <Compile Include="GUI\InitializationWindow.axaml.cs" />
    <Compile Include="GUI\HaEditorWindow.axaml.cs" />
    <!-- Re-include ported GUI support classes -->
    <Compile Include="GUI\HaRibbon.cs" />
    <Compile Include="GUI\TabItemContainer.cs" />
    <!-- Quest editor data models (no WinForms/WPF deps after Dispatcher fix) -->
    <Compile Include="GUI\Quest\QuestEditorActInfoModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorActInfoPotentialType.cs" />
    <Compile Include="GUI\Quest\QuestEditorActInfoRewardModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorActInfoRewardPropTypeModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorActSkillModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorActSpModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorActType.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckDayOfWeekModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckDayOfWeekType.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckInfoModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckItemReqModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckMobModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckQuestInfoExModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckQuestInfoModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckSkillCondType.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckSkillModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorCheckType.cs" />
    <Compile Include="GUI\Quest\QuestEditorConversationType.cs" />
    <Compile Include="GUI\Quest\QuestEditorModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorQuestReqModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorSayEndQuestModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorSayModel.cs" />
    <Compile Include="GUI\Quest\QuestEditorSkillModelJobIdWrapper.cs" />
    <Compile Include="GUI\Quest\QuestEditorStopConversationType.cs" />

    <!-- Ported Avalonia dialogs -->
    <Compile Include="GUI\InstanceEditor\InstanceEditors.cs" />
    <Compile Include="GUI\InfoEditorDialog.cs" />
    <Compile Include="GUI\MapPhysicsEditorDialog.cs" />
    <Compile Include="GUI\ManageUserObjectsDialog.cs" />
    <Compile Include="GUI\LayerChangeDialog.cs" />
    <Compile Include="GUI\NewMapDialog.cs" />
    <Compile Include="GUI\SaveMapDialog.cs" />
    <Compile Include="GUI\FieldSelectorDialog.cs" />
    <Compile Include="GUI\UserSettingsDialog.cs" />
    <Compile Include="GUI\EditorPanels\AISettingsDialog.cs" />
    <Compile Include="GUI\EditorPanels\AIMapEditWindow.cs" />

    <!-- Ported Avalonia editor panels -->
    <Compile Include="GUI\EditorPanels\LifePanel.cs" />
    <Compile Include="GUI\EditorPanels\BlackBorderPanel.cs" />
    <Compile Include="GUI\EditorPanels\ObjPanel.cs" />
    <Compile Include="GUI\EditorPanels\BackgroundPanel.cs" />

    <!-- WinForms custom controls -->
    <Compile Remove="CustomControls\**" />

    <!-- WPF IValueConverter classes -->
    <Compile Remove="Converter\**" />

    <!-- WPF/DirectX MonoGame surface embedding (replaced by MapEditorGame.cs + MapEditorControl.cs) -->
    <Compile Remove="MapEditor\MultiBoard.xaml.cs" />
    <Compile Remove="MapEditor\GraphicsDeviceService.cs" />
    <!-- Cross-platform MonoGame rendering surface (MapEditorGame.cs is auto-included from MapEditor\) -->
    <Compile Include="GUI\MapEditorControl.cs" />
    <!-- Ported left-panel editors (stubs for unported panels) -->
    <Compile Include="GUI\EditorPanels\PanelStubs.cs" />
    <!-- Avalonia TilePanel and PortalPanel (ported from WinForms) -->
    <Compile Include="GUI\EditorPanels\TilePanel.cs" />
    <Compile Include="GUI\EditorPanels\PortalPanel.cs" />

    <!-- MapEditor files with WinForms/WPF/dockpanelsuite dependencies -->
    <Compile Remove="MapEditor\AI\MarkdownToFlowDocumentConverter.cs" />
    <!-- BackupManager, HaCreatorStateManager, and InputHandler are now ported -->
    <Compile Remove="MapEditor\Input\InputHandlerStubs.cs" />

    <!-- Auto-generated WinForms resource file — replaced by cross-platform Properties\Resources.cs -->
    <Compile Remove="Properties\Resources.Designer.cs" />

    <!-- MapLoader is ported to Avalonia -->

    <!-- MapSimulator temporarily included for error assessment -->
    <!-- <Compile Remove="MapSimulator\**\*.cs" /> -->

  </ItemGroup>

  <!-- Exclude WPF XAML markup files -->
  <ItemGroup>
    <Page Remove="**\*.xaml" />
    <None Remove="**\*.xaml" />
    <EmbeddedResource Remove="**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HaSharedLibrary\HaSharedLibrary.csproj" />
    <ProjectReference Include="..\MapleLib\MapleLib\MapleLib.csproj" />
    <ProjectReference Include="..\MapleLib\spine-runtimes-2.1.25\spine-csharp\spine-csharp 2.1.25.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform UI -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />

    <!-- Cross-platform MonoGame (replaces MonoGame.Framework.WindowsDX) -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />

    <!-- Cross-platform imaging -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />

    <!-- Audio -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Midi" Version="2.2.1" />

    <!-- SQLite data source -->
    <PackageReference Include="System.Data.SQLite" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI Prompt files -->
    <Content Include="MapEditor\AI\Prompts\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>AI\Prompts\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>
</Project>
