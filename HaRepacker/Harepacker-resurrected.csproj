<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HaRepacker</RootNamespace>
    <AssemblyName>HaRepackerResurrected</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <StartupObject>HaRepacker.Program</StartupObject>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <!-- Exclude old WinForms Designer and resource stubs -->
  <ItemGroup>
    <Compile Remove="Resources\OrangeMushroom\**" />
    <EmbeddedResource Remove="Resources\OrangeMushroom\**" />
    <None Remove="Resources\OrangeMushroom\**" />
  </ItemGroup>

  <!-- Exclude WinForms-derived files until Avalonia port is complete -->
  <ItemGroup>
    <!-- Root-level WinForms files -->
    <Compile Remove="WzNode.cs" />
    <Compile Remove="TreeViewMS.cs" />
    <Compile Remove="TreeViewMS.resx" />
    <!-- UndoRedoManager.cs: ported to use HaRepacker.Models.WzNode -->
    <Compile Remove="ContextMenuManager.cs" />
    <!-- SavedFolderBrowser.cs: ported to Avalonia StorageProvider async API -->
    <Compile Remove="AnimationBuilder.cs" /><!-- excluded until APNG export is implemented cross-platform -->

    <!-- Root-level WinForms-coupled files (Warning.cs is now cross-platform, kept) -->

    <!-- GUI root forms -->
    <Compile Remove="GUI\AboutForm.cs" />
    <Compile Remove="GUI\AboutForm.Designer.cs" />
    <Compile Remove="GUI\CustomWZEncryptionInputBox.cs" />
    <Compile Remove="GUI\CustomWZEncryptionInputBox.designer.cs" />
    <Compile Remove="GUI\FirstRunForm.cs" />
    <Compile Remove="GUI\FirstRunForm.Designer.cs" />
    <Compile Remove="GUI\ListEditor.cs" />
    <Compile Remove="GUI\ListEditor.Designer.cs" />
    <Compile Remove="GUI\MainForm.cs" />
    <Compile Remove="GUI\MainForm.Designer.cs" />
    <Compile Remove="GUI\NewForm.cs" />
    <Compile Remove="GUI\NewForm.Designer.cs" />
    <Compile Remove="GUI\OptionsForm.cs" />
    <Compile Remove="GUI\OptionsForm.Designer.cs" />
    <Compile Remove="GUI\PackToWzForm.cs" />
    <Compile Remove="GUI\SaveForm.cs" />
    <Compile Remove="GUI\SaveForm.designer.cs" />
    <Compile Remove="GUI\WzKeyBruteforceForm.cs" />
    <Compile Remove="GUI\WzKeyBruteforceForm.designer.cs" />
    <Compile Remove="GUI\WzStringSearchForm.cs" />
    <Compile Remove="GUI\WzStringSearchForm.Designer.cs" />
    <!-- WzStringSearchFormDataCache.cs: ported (WinForms deps removed) -->
    <Compile Remove="GUI\ZLZPacketEncryptionKeyForm.cs" />
    <Compile Remove="GUI\ZLZPacketEncryptionKeyForm.designer.cs" />
    <!-- GUI\ContextMenuManager.cs: ported to Avalonia MenuItem/ContextMenu -->
    <Compile Remove="GUI\Resources.Designer.cs" />

    <!-- HotSwap (depends on MainForm) -->
    <Compile Remove="GUI\HotSwap\**" />

    <!-- Input and Interaction dialogs (WinForms) — replaced by InputDialogs.cs -->
    <Compile Remove="GUI\Input\**" />
    <Compile Include="GUI\Input\InputDialogs.cs" />
    <Compile Remove="GUI\Interaction\**" />

    <!-- Controls (WPF-specific) -->
    <Compile Remove="GUI\Controls\**" />

    <!-- WPF XAML code-behinds (replaced by .axaml.cs files) -->
    <Compile Remove="GUI\Panels\MainPanel.xaml.cs" />
    <Compile Remove="GUI\Panels\MainPanelPropertyItems.cs" />
    <Compile Remove="GUI\Panels\ImageAnimationPreviewWindow.cs" />
    <Compile Remove="GUI\Panels\SubPanels\ImageRenderViewer.xaml.cs" />
    <Compile Remove="GUI\Panels\SubPanels\ImageRenderViewerItem.cs" />
    <Compile Remove="GUI\Panels\SubPanels\AvalonTextEditor.xaml.cs" />
    <Compile Remove="GUI\Panels\SubPanels\LoadingPanel.xaml.cs" />
    <Compile Remove="GUI\Panels\SubPanels\XYPanel.xaml.cs" />
    <Compile Remove="GUI\Panels\SubPanels\NotifyPointF.cs" />
    <Compile Remove="GUI\Panels\SubPanels\PointFEditor.cs" />
    <Compile Remove="GUI\Panels\SubPanels\PointFEditorControl.cs" />

    <!-- FHMapper WinForms -->
    <Compile Remove="FHMapper\**" />

    <!-- Comparer/WinForms -->
    <Compile Remove="Comparer\TreeViewNodeSorter.cs" />

    <!-- WPF converters (replaced by Avalonia converters in Converters/) -->
    <Compile Remove="Converter\**" />

    <!-- Properties (WinForms-generated resource designer) -->
    <Compile Remove="Properties\Resources.Designer.cs" />
  </ItemGroup>

  <!-- Exclude WPF XAML pages (replaced by .axaml) and all WinForms resource files -->
  <ItemGroup>
    <Page Remove="GUI\Panels\MainPanel.xaml" />
    <Page Remove="GUI\Panels\SubPanels\ImageRenderViewer.xaml" />
    <Page Remove="GUI\Panels\SubPanels\AvalonTextEditor.xaml" />
    <Page Remove="GUI\Panels\SubPanels\LoadingPanel.xaml" />
    <Page Remove="GUI\Panels\SubPanels\XYPanel.xaml" />
    <!-- Exclude ALL WinForms .resx files to avoid MSB3822 non-string resource error -->
    <EmbeddedResource Remove="GUI\**" />
    <EmbeddedResource Remove="FHMapper\**" />
    <EmbeddedResource Remove="Properties\**" />
    <EmbeddedResource Remove="TreeViewMS.resx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
    <Content Include="Resources\arrow_left.png" />
    <Content Include="Resources\arrow_right.png" />
    <Content Include="Resources\Pause.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HaSharedLibrary\HaSharedLibrary.csproj" />
    <ProjectReference Include="..\MapleLib\MapleLib\MapleLib.csproj" />
    <ProjectReference Include="..\MapleLib\spine-runtimes-2.1.25\spine-csharp\spine-csharp 2.1.25.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform UI framework -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Avalonia port of AvalonEdit for syntax-highlighted text editing -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.2.0" />
    <!-- Cross-platform imaging -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.0" />
  </ItemGroup>
</Project>
