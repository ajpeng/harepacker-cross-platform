<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HaRepacker.GUI.Panels.SubPanels.XYPanel"
             Width="300" Height="160">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="X: " Foreground="Black" FontSize="17" VerticalAlignment="Center" />
                <TextBox x:Name="xBox" Width="200" Margin="20,0,0,0" Text="0" FontSize="17"
                         TextAlignment="Center"
                         TextChanged="xBox_TextChanged" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Y: " Foreground="Black" FontSize="17" VerticalAlignment="Center" />
                <TextBox x:Name="yBox" Width="200" Margin="20,0,0,0" Text="0" FontSize="17"
                         TextAlignment="Center"
                         TextChanged="yBox_TextChanged" />
            </StackPanel>
        </StackPanel>

        <Button x:Name="button_ApplyChanges" Content="Apply"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Width="250" Margin="10" Height="30"
                IsEnabled="False"
                Click="button_ApplyChanges_Click" />
    </Grid>
</UserControl>
