<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaRepacker.GUI.FirstRunFormWindow"
        Title="Welcome to HaRepacker"
        Width="400" Height="190"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <Border Padding="16">
        <StackPanel Spacing="12">
            <TextBlock Text="Welcome! This appears to be your first time running HaRepacker."
                       TextWrapping="Wrap" />
            <CheckBox x:Name="autoAssociateBox" Content="Auto-associate .wz files with HaRepacker" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Continue" Width="100" Click="OnContinueClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
