<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:HaRepacker.GUI.Panels"
        x:Class="HaRepacker.GUI.MainWindow"
        Title="HaRepacker - Resurrected (Cross-Platform)"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="500">
    <DockPanel>
        <!-- Top menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open WZ File…" Click="OnOpenClick" />
                <MenuItem Header="_New WZ File…" Click="OnNewClick" />
                <MenuItem Header="_Save Selected…" Click="OnSaveClick" />
                <Separator />
                <MenuItem Header="_Options…" Click="OnOptionsClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="OnUndoClick" />
                <MenuItem Header="_Redo" Click="OnRedoClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About…" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <Panel DockPanel.Dock="Bottom" Height="22" Background="#DDDDDD">
            <TextBlock x:Name="statusLabel" Text="Ready" Margin="5,2,0,0" FontSize="11" />
        </Panel>

        <!-- Main content panel -->
        <panels:MainPanel x:Name="mainPanel" />
    </DockPanel>
</Window>
