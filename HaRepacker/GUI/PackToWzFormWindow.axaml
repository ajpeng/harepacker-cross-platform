<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HaRepacker.GUI.PackToWzFormWindow"
        Title="Pack IMG Files to WZ"
        Width="420" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Border Padding="12">
        <StackPanel Spacing="8">

            <!-- Version info -->
            <TextBlock x:Name="label_versionInfo" Text="Version: Unknown" />
            <TextBlock x:Name="label_format"      Text="Source: Unknown" Foreground="DarkBlue" />

            <!-- Category list -->
            <TextBlock Text="Categories to pack:" FontWeight="SemiBold" />
            <Border BorderBrush="Gray" BorderThickness="1" Height="180">
                <ScrollViewer>
                    <StackPanel x:Name="categoriesPanel" Margin="4" Spacing="3" />
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button Content="Select All"  Click="OnSelectAllClick"  />
                <Button Content="Select None" Click="OnSelectNoneClick" />
            </StackPanel>

            <!-- Output path -->
            <TextBlock Text="Output path:" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="textBox_outputPath" Grid.Column="0" />
                <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseClick" />
            </Grid>

            <!-- Options row -->
            <Grid ColumnDefinitions="*,*">
                <CheckBox x:Name="checkBox_64bit"      Grid.Column="0" Content="64-bit WZ format"
                          IsCheckedChanged="OnFormatChanged" />
                <CheckBox x:Name="checkBox_betaFormat" Grid.Column="1" Content="Beta Data.wz"
                          IsCheckedChanged="OnFormatChanged" />
            </Grid>

            <!-- Patch version + Encryption -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,*">
                <TextBlock Grid.Column="0" Text="Patch Version (0=auto):" VerticalAlignment="Center" Margin="0,0,6,0" />
                <NumericUpDown x:Name="numericUpDown_patchVersion" Grid.Column="1"
                               Minimum="0" Maximum="32767" Value="0" FormatString="0" Width="80" />
                <TextBlock Grid.Column="3" Text="Encryption:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox x:Name="comboBox_encryption" Grid.Column="4" HorizontalAlignment="Stretch" />
            </Grid>

            <!-- Progress -->
            <ProgressBar x:Name="progressBar" Minimum="0" Maximum="100" Value="0" Height="20" />
            <TextBlock x:Name="label_status" Text="Ready" />

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="button_pack" Content="Pack"  Width="80" Click="OnPackClick" />
                <Button x:Name="button_close" Content="Close" Width="80" Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
